# QuantScope Environment Variables

# Backend API settings
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development

# Database Settings
# For initial Phase 1, we can use SQLite
DATABASE_URL=sqlite:///./quantscope.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/quantscope

# AI Provider Settings
# AI_PROVIDER can be 'gemini', 'openai', etc.
AI_PROVIDER=gemini
AI_API_KEY=your_api_key_here

# Market Data API Keys
# YFINANCE doesn't need an API key typically, but others might.
FMP_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
